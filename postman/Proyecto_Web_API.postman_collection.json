    {
      "name": "Procesos",
      "item": [
        {
          "name": "GET Proceso por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 404', function () {",
                  "  pm.expect([200, 404]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response time is below 4000ms', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(4000);",
                  "});",
                  "",
                  "pm.test('Response shape matches status', function () {",
                  "  var jsonData = pm.response.json();",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "  } else {",
                  "    pm.expect(jsonData).to.have.property('error');",
                  "    pm.expect(jsonData.error).to.match(/Not Found|No encontrado/i);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/procesos/{{procesoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "procesos",
                "{{procesoId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Notificaciones",
      "item": [
        {
          "name": "POST Enviar Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has enviado field', function () {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData).to.have.property('data');",
                  "  pm.expect(jsonData.data).to.have.property('enviado');",
                  "});",
                  "",
                  "pm.test('Response time is below 3000ms', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notificaciones/email?destino=test@correo.com&asunto=Prueba&cuerpo=Hola",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notificaciones",
                "email"
              ],
              "query": [
                {
                  "key": "destino",
                  "value": "test@correo.com"
                },
                {
                  "key": "asunto",
                  "value": "Prueba"
                },
                {
                  "key": "cuerpo",
                  "value": "Hola"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
